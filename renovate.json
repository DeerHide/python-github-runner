    },
    {
      "customType": "regex",
      "description": "Update crane (go-containerregistry) version",
      "fileMatch": ["^Containerfile$", "^manifest\\.yaml$"],
      "matchStrings": ["CRANE_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "google/go-containerregistry",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update Node.js version",
      "fileMatch": ["^Containerfile$", "^manifest\\.yaml$"],
      "matchStrings": ["NODE_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "description": "Update Bun version",
      "fileMatch": ["^Containerfile$", "^manifest\\.yaml$"],
      "matchStrings": ["BUN_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "oven-sh/bun",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^bun-v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update Rust toolchain version",
      "fileMatch": ["^Containerfile$", "^manifest\\.yaml$"],
